# Copy to .env (git-ignored) and adjust. Never commit real secrets.

# Application
APP_ENV=development

# Postgres (used by docker-compose.yml)
# Host port 5433, not 5432, so the Docker DB doesn't clash with a natively
# installed PostgreSQL service (common on Windows) that already uses 5432.
POSTGRES_USER=engimentor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=engimentor
POSTGRES_PORT=5433

# SQLAlchemy URL used by the backend and Alembic (psycopg 3 driver).
# Keep user/password/port in sync with the values above.
DATABASE_URL=postgresql+psycopg://engimentor:change-me@localhost:5433/engimentor
# Hosted Postgres (e.g. Neon) URLs starting postgres:// or postgresql:// are accepted as-is.

# Optional: where uploads are extracted (default: <repo>/storage, git-ignored) and upload cap.
# STORAGE_DIR=./storage
# MAX_UPLOAD_MB=50

# AI provider for summaries and learning features (see docs/adr/0005-free-llm-providers.md).
#   fake              - offline, deterministic answers (default; no setup)
#   openai_compatible - any OpenAI-style chat API. All the options below are free.
# Never commit real API keys.
LLM_PROVIDER=fake

# Option 1 (recommended): Ollama on this machine. Free, no key, code never leaves your laptop.
#   Install from https://ollama.com, then run:  ollama pull qwen2.5-coder:7b
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:7b

# Option 2: Groq free tier (key from https://console.groq.com/keys)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=

# Option 3: Google Gemini free tier (key from https://aistudio.google.com/apikey)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=

# Option 4: OpenRouter free models (key from https://openrouter.ai/keys; pick a model ending in :free)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=
# LLM_API_KEY=

# LLM_TIMEOUT_SECONDS=180

# Accounts. Session cookies are Secure (HTTPS-only) whenever APP_ENV is not "development".
# SESSION_DAYS=14
# PASSWORD_RESET_MINUTES=30
# Frontend URL used in password-reset links.
APP_URL=http://localhost:5173
# "console" logs reset links to the API console. A real email provider needs approval first.
EMAIL_BACKEND=console
